# ─── Gmail (IMAP avec App Password Google) ────────────────────────────────────
# Ton adresse Gmail
GMAIL_ADDRESS=ton.email@gmail.com

# Mot de passe d'application Google (16 caractères, sans espaces)
# Créer ici : myaccount.google.com/apppasswords
# (Nécessite la validation en 2 étapes activée)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Expéditeur à surveiller (contenu du champ From)
MALOCATEAM_SENDER=malocateam

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
# Compte Twilio : console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numéro Twilio source (format international, ex: +33XXXXXXXXX)
TWILIO_PHONE_NUMBER=+33XXXXXXXXX

# Ton numéro de téléphone cible (format international)
MY_PHONE_NUMBER=+33XXXXXXXXX

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
# Clé API : console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Comportement de l'agent ──────────────────────────────────────────────────
# Nombre de jours avant la fin du mois pour commencer à vérifier (défaut: 5)
LAST_DAYS_THRESHOLD=5
